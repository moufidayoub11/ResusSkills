# Copy to .env.local and fill in.

# MongoDB connection string (a replica set is required for professor edits).
MONGODB_URI=mongodb://localhost:27017/resusskills

# Auth.js: generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Google OAuth (optional; see docs/google-auth.md).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
